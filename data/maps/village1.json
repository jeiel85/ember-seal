			"shop": "v1_store",
			"dialog": [
				{ "cond": {}, "lines": [ "여행 준비는 됐나? 없는 건 없어." ] }
			]
		},
		{
			"id": "burner",
			"name": "숯장이 베르",
			"x": 18, "y": 12,
			"palette": { "H": "#8a6a4a", "S": "#d8a878", "E": "#1a1a24", "C": "#6a6a56", "c": "#525244", "B": "#4a3a2a" },
			"dialog": [
				{ "cond": { "stage_max": 3 }, "lines": [ "우리는 매년 숯을 태워 연기를 등대로 보내지.", "할아버지 대부터 그렇게 했는데… 왜인지는 아무도 몰라." ] },
				{ "cond": { "stage_min": 4 }, "lines": [ "숯연기가 봉인의 양식이라고…? 그럼 우리는 뭘 위해 태운 거야…" ] }
			]
		},
		{
			"id": "kid",
			"name": "마을 아이",
			"x": 12, "y": 7,
			"palette": { "H": "#c88a3a", "S": "#f0c8a0", "E": "#1a1a24", "C": "#c85a5a", "c": "#a84444", "B": "#5a4632" },
			"dialog": [
				{ "cond": { "stage_max": 0 }, "lines": [ "룬! 큰일 났어! 어젯밤부터 등대 불이 안 보여!", "아빠가 백 년 만의 일이라고 하셨어." ] },
				{ "cond": { "stage_min": 1 }, "lines": [ "룬이가 마수를 잡았다며? 멋있다!", "나도 커서 등대 지기가 될 거야." ] }
			]
		},
		{
			"id": "granny",
			"name": "노인 할멈",
			"x": 7, "y": 12,
			"palette": { "H": "#e8e8e8", "S": "#e8c0a0", "E": "#1a1a24", "C": "#8a8a96", "c": "#6a6a76", "B": "#4a3a2a" },
			"dialog": [
				{ "cond": {}, "lines": [ "등대가 꺼지면 골짜기가 재가 된다는 옛말이 있지.", "그냥 옛말이라고 생각했는데… 마음이 불안하구나." ] }
			]
		}
